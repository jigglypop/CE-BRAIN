#!/bin/sh
# Run a script with the pinned CE-BRAIN research environment (env/uv.lock). Usage: env/py step64_x/script.py [args]
# One BLAS / OpenMP thread per process unless set by the caller: sums then run in one fixed order, so a result does
# not depend on the thread count (serial and batch runs agree bit for bit), and batch workers do not oversubscribe.
: "${OPENBLAS_NUM_THREADS:=1}" "${OMP_NUM_THREADS:=1}" "${MKL_NUM_THREADS:=1}"
export OPENBLAS_NUM_THREADS OMP_NUM_THREADS MKL_NUM_THREADS
exec "$(dirname "$0")/.venv/Scripts/python.exe" "$@"
